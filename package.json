{
  "name": "r4r",
  "version": "0.0.1",
  "description": "r4r",
  "license": "GPL-3.0",
  "scripts": {
    "build-scss": "sass --style compressed ./media/scss/main.scss ./media/css/main.css",
    "dev": "webpack --mode development --watch --config media/js/config/webpack.config.dev.cjs",
    "eslint": "eslint media/js/src/*.js",
